{
  "name": "meeting-live-captions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:assets": "node scripts/build-assets.mjs",
    "dev:cloudflare": "npm run build:assets && wrangler dev --local",
    "deploy": "npm run build:assets && wrangler deploy",
    "check:cloudflare": "npm run build:assets && wrangler deploy --dry-run",
    "test:cloudflare": "node --test scripts/smoke-cloudflare.mjs",
    "build": "npm run build:assets",
    "test:ui": "node --test scripts/ui-smoke.mjs",
    "eval:glossary": "node scripts/evaluate-glossary.mjs --cases evaluation/glossary/development-cases.json",
    "eval:glossary:candidate": "node scripts/evaluate-glossary.mjs --cases evaluation/glossary/development-cases.json --candidate evaluation/glossary/context-prefix-experiment.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "ROOMS": {
        "description": "每個字幕房間的 WebSocket 連線、權限與最近字幕；使用支援免費方案的 SQLite Durable Objects。"
      },
      "CREATE_LIMIT": {
        "description": "建立房間的請求限流，避免大量建立房間。"
      }
    }
  }
}
