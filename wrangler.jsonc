{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meeting-live-captions",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "ROOMS", "class_name": "CaptionRoom"},
      {"name": "CREATE_LIMIT", "class_name": "CreateLimit"},
      {"name": "SPEECH_LIMIT", "class_name": "SpeechLimit"}
    ]
  },
  "ai": {"binding": "AI"},
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["CaptionRoom", "CreateLimit"]},
    {"tag": "v2", "new_sqlite_classes": ["SpeechLimit"]}
  ]
}
